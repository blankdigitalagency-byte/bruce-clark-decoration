---
import { business } from "../data/business";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<section class="bg-olive-50/60">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="max-w-2xl">
      <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight text-ink-900 sm:text-4xl lg:text-5xl">{title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-700/85">{description}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full bg-olive-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-olive-700">
          Get a Free Quote
        </a>
        <a href={business.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink-900/15 px-6 py-3 text-sm font-bold text-ink-900 transition hover:bg-ink-900/5">
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>
