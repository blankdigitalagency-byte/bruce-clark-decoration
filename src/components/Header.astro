---
import Logo from "./Logo.astro";
import { business, services } from "../data/business";

const { pathname } = Astro.url;
const isServicePage = services.some((s) => pathname === `/${s.slug}`);

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/gallery", label: "Gallery" },
  { href: "/about-us", label: "About" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact Us" },
];

const linkBase = "rounded-full px-3.5 py-2 text-sm font-medium text-ink-800 transition hover:bg-olive-50 hover:text-olive-700";
const linkActive = "bg-olive-100 text-olive-700 font-semibold hover:bg-olive-100";
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0">
      <Logo variant="dark" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <a href="/" class:list={[linkBase, pathname === "/" && linkActive]}>Home</a>

      <div class="group relative">
        <button
          class:list={[linkBase, "flex items-center gap-1", isServicePage && linkActive]}
          aria-haspopup="true"
        >
          Decorating Services
          <svg class="h-3.5 w-3.5" viewBox="0 0 12 8" fill="none"><path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <div class="invisible absolute left-1/2 top-full w-80 -translate-x-1/2 pt-3 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <ul class="rounded-xl bg-white p-2 text-ink-900 shadow-brand ring-1 ring-black/5">
            {services.map((s) => (
              <li>
                <a href={`/${s.slug}`} class="block rounded-lg px-3.5 py-2.5 text-sm hover:bg-olive-50">{s.navLabel}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="/gallery" class:list={[linkBase, pathname === "/gallery" && linkActive]}>Gallery</a>
      <a href="/about-us" class:list={[linkBase, pathname === "/about-us" && linkActive]}>About</a>
      <a href="/faq" class:list={[linkBase, pathname === "/faq" && linkActive]}>FAQ</a>
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a href={business.phoneHref} class="text-sm font-semibold text-ink-800 hover:text-olive-600">{business.phoneDisplay}</a>
      <a
        href="/contact"
        class="rounded-full bg-olive-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-olive-700"
      >
        Contact Us
      </a>
    </div>

    <button id="menu-toggle" class="p-2 lg:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="h-6 w-6 text-ink-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-black/5 bg-white lg:hidden">
    <nav class="flex flex-col gap-1 px-4 py-4" aria-label="Mobile">
      {navLinks.map((l) => (
        <a href={l.href} class:list={["rounded-lg px-3 py-2.5 text-sm font-medium text-ink-800 hover:bg-olive-50", pathname === l.href && "bg-olive-100 text-olive-700 font-semibold"]}>{l.label}</a>
      ))}
      <p class="mt-2 px-3 text-xs font-semibold uppercase tracking-wide text-ink-700/50">Decorating Services</p>
      {services.map((s) => (
        <a href={`/${s.slug}`} class="rounded-lg px-3 py-2.5 text-sm text-ink-800 hover:bg-olive-50">{s.navLabel}</a>
      ))}
      <a href={business.phoneHref} class="mt-3 rounded-full bg-olive-600 px-5 py-3 text-center text-sm font-bold text-white">
        Call now: {business.phoneDisplay}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(isHidden));
  });
</script>
