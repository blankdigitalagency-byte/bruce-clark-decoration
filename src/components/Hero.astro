---
import PhotoPlaceholder from "./PhotoPlaceholder.astro";
import { business } from "../data/business";
import heroPhoto from "../assets/photos/bathroom-green-tile-repaint.jpg";

interface Props {
  answerSentence: string;
}
const { answerSentence } = Astro.props;
---

<section class="overflow-hidden bg-gradient-to-b from-cream-100 to-white">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-start lg:py-24 lg:px-8">
    <div>
      <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.15em] text-olive-700">
        <span class="h-px w-8 bg-olive-600"></span>
        Residential &amp; Commercial Decorating
      </p>
      <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.15] tracking-tight text-ink-900 sm:text-5xl lg:text-[3.1rem]">
        Painters &amp; Decorators<br />
        Edinburgh &amp; Lothians or Surrounding Areas<br />
        <span class="text-olive-600"><em class="italic">Trusted</em> for {business.yearsExperience} Years</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-700/85">
        {answerSentence}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full bg-olive-600 px-7 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-olive-700">
          Get a Free Quote
        </a>
        <a href={business.phoneHref} class="text-sm font-bold text-ink-900 underline decoration-olive-600 decoration-2 underline-offset-4 transition hover:text-olive-700">
          Call {business.phoneDisplay}
        </a>
      </div>
    </div>

    <div class="relative">
      <PhotoPlaceholder
        caption="Recent project — bathroom repaint, Edinburgh"
        aspect="wide"
        image={heroPhoto}
        imageAlt="Green tiled bathroom repaint with brass fixtures by Bruce Clark Decoration, Edinburgh painters and decorators"
      />
      <div class="absolute bottom-4 left-4 hidden rounded-2xl bg-white p-5 shadow-brand ring-1 ring-black/5 sm:block">
        <p class="font-display text-3xl font-semibold text-olive-600">{business.yearsExperience}</p>
        <p class="text-xs font-medium text-ink-700/70">Years' Experience</p>
      </div>
    </div>
  </div>
</section>
