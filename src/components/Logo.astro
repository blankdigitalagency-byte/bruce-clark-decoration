---
import { Image } from "astro:assets";
import logo from "../assets/bruce-clark-logo.png";

interface Props {
  variant?: "dark" | "light";
  class?: string;
}
const { variant = "dark", class: className = "" } = Astro.props;
const invert = variant === "light" ? "invert" : "";
---

<Image
  src={logo}
  alt="Bruce Clark Decoration"
  width={900}
  height={70}
  class={`h-5 w-auto object-contain sm:h-6 lg:h-7 ${invert} ${className}`}
/>
