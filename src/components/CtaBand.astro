---
import { business } from "../data/business";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Ready to start your project?",
  description = "Get in touch today for a free, no-obligation quote — every job is priced individually and finished to an exacting standard.",
} = Astro.props;

const titleWords = title.trim().split(" ");
const titleLastWord = titleWords.pop();
const titleLead = titleWords.join(" ");
---

<section class="bg-ink-900">
  <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      {titleLead}{titleLead && " "}<span class="text-olive-400">{titleLastWord}</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-white/75">{description}</p>

    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full bg-olive-500 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-olive-400">
        Get a Free Quote
      </a>
      <a href={business.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-white/25 px-7 py-3.5 text-sm font-bold text-white transition hover:bg-white/10">
        Call {business.phoneDisplay}
      </a>
    </div>
  </div>
</section>
