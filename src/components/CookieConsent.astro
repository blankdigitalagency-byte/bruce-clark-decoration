---
// TODO(client): once GA4 is set up under your own Google account, drop the Measurement ID
// into GA_MEASUREMENT_ID below. Until then this banner still renders (harmless) but there is
// nothing to consent to yet — GA4 only loads after "Accept" is clicked AND an ID is set.
const GA_MEASUREMENT_ID = "G-XXXXXXXXXX";
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-black/10 bg-white/95 p-4 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] backdrop-blur sm:p-5"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 sm:flex-row sm:justify-between">
    <p class="text-sm text-ink-700/85">
      We use a small amount of analytics cookies to understand how visitors use this site. See our
      <a href="/privacy-policy" class="font-medium text-olive-700 underline underline-offset-2">Privacy Policy</a> for details.
    </p>
    <div class="flex shrink-0 gap-3">
      <button id="cookie-decline" type="button" class="rounded-full border border-black/15 px-4 py-2 text-sm font-semibold text-ink-800 hover:bg-black/5">
        Decline
      </button>
      <button id="cookie-accept" type="button" class="rounded-full bg-olive-600 px-4 py-2 text-sm font-semibold text-white hover:bg-olive-700">
        Accept
      </button>
    </div>
  </div>
</div>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  function loadGA4() {
    if (!GA_MEASUREMENT_ID || GA_MEASUREMENT_ID.includes("XXXX") || window.__ga4Loaded) return;
    window.__ga4Loaded = true;
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag("js", new Date());
    gtag("config", GA_MEASUREMENT_ID, { anonymize_ip: true });
    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);
  }

  const banner = document.getElementById("cookie-consent");
  const stored = localStorage.getItem("bcd-cookie-consent");

  if (stored === "granted") {
    loadGA4();
  } else if (stored !== "denied") {
    banner?.classList.remove("hidden");
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    localStorage.setItem("bcd-cookie-consent", "granted");
    banner?.classList.add("hidden");
    loadGA4();
  });

  document.getElementById("cookie-decline")?.addEventListener("click", () => {
    localStorage.setItem("bcd-cookie-consent", "denied");
    banner?.classList.add("hidden");
  });
</script>
