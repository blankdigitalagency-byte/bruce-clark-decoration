---
const steps = [
  { n: "1", title: "Get In Touch", desc: "Call us or fill out our contact form with a few details." },
  { n: "2", title: "Free Quote", desc: "We'll visit to see the job and provide a clear, no-obligation quote." },
  { n: "3", title: "The Work", desc: "We protect your home or premises, prepare meticulously, and carry out the work to an exacting standard." },
  { n: "4", title: "Finished & Tidy", desc: "We clean up thoroughly and walk through the finished work with you before we leave." },
];
---

<section class="bg-beige-50">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Our Process</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">How We <span class="text-olive-600">Work</span></h2>
      <p class="mt-4 text-ink-700/80">A considered process, from first enquiry to a flawless finish</p>
    </div>

    <ol class="relative mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="pointer-events-none absolute top-6 hidden h-px w-full bg-olive-600/15 lg:block" aria-hidden="true"></div>
      {steps.map((s) => (
        <li class="relative flex flex-col items-center text-center lg:items-start lg:text-left">
          <span class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-olive-600 font-display text-lg font-bold text-white ring-8 ring-beige-50">
            {s.n}
          </span>
          <h3 class="mt-5 font-display text-base font-bold text-ink-900">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-700/75">{s.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
