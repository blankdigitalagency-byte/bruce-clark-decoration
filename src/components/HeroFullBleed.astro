---
import { Image } from "astro:assets";
import { business } from "../data/business";
import heroPhoto from "../assets/photos/bathroom-green-tile-repaint.jpg";

interface Props {
  answerSentence: string;
}
const { answerSentence } = Astro.props;
---

<section class="overflow-hidden bg-white">
  <div class="relative">
    <Image
      src={heroPhoto}
      alt="Green tiled bathroom repaint with brass fixtures by Bruce Clark Decoration, Edinburgh painters and decorators"
      width={2000}
      height={2200}
      loading="eager"
      fetchpriority="high"
      class="h-[36vh] w-full object-cover sm:h-[62vh] lg:h-[82vh]"
    />

    <div class="px-4 sm:absolute sm:inset-x-0 sm:bottom-0 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="-mt-10 max-w-lg rounded-2xl bg-cream-50 p-7 shadow-brand sm:mt-0 sm:translate-y-1/2 sm:p-9 lg:translate-y-2/5 lg:p-10">
          <p class="inline-flex items-center gap-2 rounded-full bg-olive-600 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-white">
            Residential &amp; Commercial Decorating
          </p>
          <h1 class="mt-5 font-display text-3xl font-semibold leading-[1.15] tracking-tight text-ink-900 sm:text-4xl lg:text-[2.6rem]">
            Painters &amp; Decorators<br />
            Edinburgh &amp; Lothians or Surrounding Areas<br />
            <span class="text-olive-600">Trusted for {business.yearsExperience} Years</span>
          </h1>
          <p class="mt-5 leading-relaxed text-ink-700/85">
            {answerSentence}
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full bg-olive-600 px-7 py-3.5 text-sm font-bold text-white shadow-sm transition hover:bg-olive-700">
              Get a Free Quote
            </a>
            <a href={business.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink-900/15 px-7 py-3.5 text-sm font-bold text-ink-900 transition hover:bg-ink-900/5">
              Call {business.phoneDisplay}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="h-6 sm:h-52 lg:h-60"></div>
</section>
