---
import Icon from "./Icon.astro";
import { services } from "../data/business";

interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;
const items = currentSlug ? services.filter((s) => s.slug !== currentSlug) : services;
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Decorating Services</p>
    <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">
      What We Do
    </h2>
    <p class="mt-4 text-ink-700/80">Interior and exterior painting and decorating across Edinburgh and the Lothians</p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((s) => (
      <a
        href={`/${s.slug}`}
        class="group flex flex-col rounded-2xl border border-black/5 bg-white p-7 shadow-sm ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-brand"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-olive-50 text-olive-600">
          <Icon name={s.icon} class="h-6 w-6" />
        </div>
        <h3 class="mt-5 font-display text-lg font-bold text-ink-900">{s.shortName}</h3>
        <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-700/75">{s.summary}</p>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-olive-600 transition-all group-hover:gap-2">
          Learn more
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    ))}
  </div>
</section>
