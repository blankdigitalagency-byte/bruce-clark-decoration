---
---

<!--
  TODO(client): replace WEB3FORMS_ACCESS_KEY below with your own free key from
  https://web3forms.com (same key used on the main contact form).
-->
<form
  id="hero-enquiry-form"
  method="POST"
  action="https://api.web3forms.com/submit"
  class="space-y-4"
  novalidate
>
  <input type="hidden" name="access_key" value="WEB3FORMS_ACCESS_KEY" />
  <input type="hidden" name="subject" value="New quick enquiry from bcdecoration.com" />
  <input type="hidden" name="from_name" value="Bruce Clark Decoration website" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div>
    <label for="hero-name" class="block text-xs font-semibold uppercase tracking-wide text-ink-900">Name</label>
    <input id="hero-name" name="name" type="text" required autocomplete="name"
      class="mt-1.5 block w-full rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100" />
  </div>
  <div>
    <label for="hero-phone" class="block text-xs font-semibold uppercase tracking-wide text-ink-900">Phone</label>
    <input id="hero-phone" name="phone" type="tel" required autocomplete="tel"
      class="mt-1.5 block w-full rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100" />
  </div>
  <div>
    <label for="hero-message" class="block text-xs font-semibold uppercase tracking-wide text-ink-900">Your Project</label>
    <textarea id="hero-message" name="message" rows="3" required
      class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100"></textarea>
  </div>

  <div class="flex items-start gap-2.5">
    <input id="hero-consent" name="consent" type="checkbox" required
      class="mt-0.5 h-4 w-4 rounded border-black/25 text-olive-600 focus:ring-olive-500" />
    <label for="hero-consent" class="text-xs leading-relaxed text-ink-800/85">
      I agree to my details being stored to respond to this enquiry, per the{" "}
      <a href="/privacy-policy" class="font-medium text-olive-700 underline underline-offset-2">Privacy Policy</a>.
    </label>
  </div>

  <button type="submit"
    class="w-full rounded-full bg-olive-600 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-olive-700 disabled:cursor-not-allowed disabled:opacity-60">
    Send Enquiry
  </button>

  <p id="hero-form-status" role="status" aria-live="polite" class="text-center text-sm"></p>
  <p class="text-center text-xs text-ink-800/70">We'll come back to you within one working day.</p>
</form>

<script>
  const form = document.getElementById("hero-enquiry-form") as HTMLFormElement | null;
  const status = document.getElementById("hero-form-status");
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    submitButton.disabled = true;
    status.textContent = "Sending...";
    status.className = "text-center text-sm text-ink-700/70";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Thanks — your message has been sent. We'll be in touch within one working day.";
        status.className = "text-center text-sm font-medium text-olive-700";
        form.reset();
        window.dispatchEvent(new CustomEvent("contact-form-submitted"));
        (window as any).gtag?.("event", "generate_lead", { form_name: "hero" });
      } else {
        throw new Error(result.message || "Something went wrong");
      }
    } catch (error) {
      status.textContent = "Sorry, something went wrong sending your message. Please call us instead.";
      status.className = "text-center text-sm font-medium text-red-700";
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
