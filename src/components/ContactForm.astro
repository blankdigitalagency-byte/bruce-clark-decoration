---
import { services } from "../data/business";
---

<!--
  TODO(client): replace WEB3FORMS_ACCESS_KEY below with your own free key from
  https://web3forms.com (sign up with your own email — no card required, 250
  submissions/month free). Submissions will arrive directly in that inbox.
-->
<form
  id="contact-form"
  method="POST"
  action="https://api.web3forms.com/submit"
  class="space-y-5 rounded-2xl border border-black/10 bg-white p-7 shadow-brand sm:p-9"
  novalidate
>
  <input type="hidden" name="access_key" value="WEB3FORMS_ACCESS_KEY" />
  <input type="hidden" name="subject" value="New enquiry from bcdecoration.com" />
  <input type="hidden" name="from_name" value="Bruce Clark Decoration website" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="block text-sm font-semibold text-ink-900">Full name</label>
      <input id="name" name="name" type="text" required autocomplete="name"
        class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100" />
    </div>
    <div>
      <label for="phone" class="block text-sm font-semibold text-ink-900">Phone number</label>
      <input id="phone" name="phone" type="tel" required autocomplete="tel"
        class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100" />
    </div>
  </div>

  <div>
    <label for="email" class="block text-sm font-semibold text-ink-900">Email address</label>
    <input id="email" name="email" type="email" required autocomplete="email"
      class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100" />
  </div>

  <div>
    <label for="service" class="block text-sm font-semibold text-ink-900">What do you need help with?</label>
    <select id="service" name="service"
      class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100">
      {services.map((s) => <option value={s.name}>{s.shortName}</option>)}
      <option value="Other">Other / Not sure</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-ink-900">Your Project</label>
    <textarea id="message" name="message" rows="4" required aria-describedby="message-hint"
      class="mt-1.5 block w-full rounded-lg border border-black/15 px-3.5 py-2.5 text-sm focus:border-olive-500 focus:outline-none focus:ring-2 focus:ring-olive-100"></textarea>
    <p id="message-hint" class="mt-1.5 text-xs text-ink-700/60">Include the property location and rough size of the job if you can — it helps us quote accurately.</p>
  </div>

  <div class="flex items-start gap-3">
    <input id="consent" name="consent" type="checkbox" required
      class="mt-0.5 h-4 w-4 rounded border-black/25 text-olive-600 focus:ring-olive-500" />
    <label for="consent" class="text-xs leading-relaxed text-ink-700/75">
      I agree to Bruce Clark Decoration storing my details to respond to this enquiry, in line with the{" "}
      <a href="/privacy-policy" class="font-medium text-olive-700 underline underline-offset-2">Privacy Policy</a>.
    </label>
  </div>

  <button type="submit"
    class="w-full rounded-full bg-olive-600 px-6 py-3.5 text-sm font-bold text-white transition hover:bg-olive-700 disabled:cursor-not-allowed disabled:opacity-60">
    Send Enquiry
  </button>

  <p id="form-status" role="status" aria-live="polite" class="text-center text-sm"></p>
  <p class="text-center text-xs text-ink-700/60">We'll get back to you within one working day.</p>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !submitButton) return;

    submitButton.disabled = true;
    status.textContent = "Sending...";
    status.className = "text-center text-sm text-ink-700/70";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Thanks — your message has been sent. We'll be in touch within one working day.";
        status.className = "text-center text-sm font-medium text-olive-700";
        form.reset();
        window.dispatchEvent(new CustomEvent("contact-form-submitted"));
        (window as any).gtag?.("event", "generate_lead", { form_name: "contact" });
      } else {
        throw new Error(result.message || "Something went wrong");
      }
    } catch (error) {
      status.textContent = "Sorry, something went wrong sending your message. Please call us instead.";
      status.className = "text-center text-sm font-medium text-red-700";
    } finally {
      submitButton.disabled = false;
    }
  });
</script>
