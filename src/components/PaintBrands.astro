---
import { Image } from "astro:assets";
import benjaminMoore from "../assets/brands/benjamin-moore.png";
import farrowAndBall from "../assets/brands/farrow-and-ball.png";
import littleGreene from "../assets/brands/little-greene.png";
import coat from "../assets/brands/coat.png";
import crown from "../assets/brands/crown.png";
import dulux from "../assets/brands/dulux.png";
import paintAndPaperLibrary from "../assets/brands/paint-and-paper-library.png";
import zinsser from "../assets/brands/zinsser.png";

const logos = [
  { name: "Benjamin Moore", src: benjaminMoore },
  { name: "Farrow & Ball", src: farrowAndBall },
  { name: "Little Greene", src: littleGreene },
  { name: "COAT", src: coat },
  { name: "Crown", src: crown },
  { name: "Dulux", src: dulux },
  { name: "Paint & Paper Library", src: paintAndPaperLibrary, big: true },
  { name: "Zinsser", src: zinsser },
];
---

<section class="bg-cream-100">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Paints We Use</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">
        Materials We <span class="text-olive-600">Trust</span>
      </h2>
      <p class="mt-4 text-ink-700/80">
        We work with a range of trade and premium paint brands, choosing whichever suits the job and the finish you're after. Benjamin Moore is one of our particular favourites for its depth of colour and quality of finish.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {logos.map((l) => (
        <div class="group flex h-20 items-center justify-center">
          <Image
            src={l.src}
            alt={`${l.name} paint`}
            class:list={[
              "w-auto object-contain opacity-70 transition duration-200 group-hover:scale-105 group-hover:opacity-100",
              l.big ? "max-h-20 max-w-[11rem]" : "max-h-14 max-w-[9rem]",
            ]}
          />
        </div>
      ))}
    </div>
  </div>
</section>
