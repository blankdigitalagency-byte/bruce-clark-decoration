---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CtaBand from "../components/CtaBand.astro";

import bathroomGreenTile from "../assets/photos/bathroom-green-tile-repaint.jpg";
import bayWindowBareFloor from "../assets/photos/bay-window-room-bare-floor.jpg";
import bayWindowCorner from "../assets/photos/bay-window-room-corner.jpg";
import bedroomDarkWoodwork from "../assets/photos/bedroom-dark-woodwork.jpg";
import bedroomWallpaperChandelier from "../assets/photos/bedroom-wallpaper-chandelier.jpg";
import exteriorNavyDoor from "../assets/photos/exterior-navy-front-door.jpg";
import landingPlain from "../assets/photos/landing-plain-repaint.jpg";
import landingRadiator from "../assets/photos/landing-radiator-repaint.jpg";
import livingRoomSageGreen from "../assets/photos/living-room-sage-green-repaint.jpg";
import roomPlainDoor from "../assets/photos/room-plain-door-radiator.jpg";
import scaffoldPrep from "../assets/photos/scaffold-interior-preparation.jpg";
import wallpaperMural from "../assets/photos/wallpaper-mural-feature-wall.jpg";
import kitchenGreyIsland from "../assets/photos/kitchen-grey-island-repaint.jpg";
import conservatoryExterior from "../assets/photos/conservatory-exterior-repaint.jpg";
import bedroomTanPanelledDoor from "../assets/photos/bedroom-tan-panelled-door.jpg";
import paintSprayerEquipment from "../assets/photos/paint-sprayer-equipment.jpg";
import stainedGlassStaircase from "../assets/photos/stained-glass-staircase-repaint.jpg";
import communalStairMustard from "../assets/photos/communal-stair-mustard-terracotta.jpg";
import wardrobeBurgundy from "../assets/photos/wardrobe-burgundy-fitted.jpg";
import communalStairEntranceHall from "../assets/photos/communal-stair-entrance-hall.jpg";
import communalStairCorridor from "../assets/photos/communal-stair-corridor.jpg";
import wardrobeNavyEaves from "../assets/photos/wardrobe-navy-eaves-fitted.jpg";
import amesTapingNewington from "../assets/photos/ames-taping-newington.jpg";
import bedroomDarkGreenNewTown from "../assets/photos/bedroom-dark-green-new-town.jpg";
import staircaseModernGrange from "../assets/photos/staircase-modern-the-grange.jpg";
import hallwayBirdWallpaperStockbridge from "../assets/photos/hallway-bird-wallpaper-stockbridge.jpg";
import staircaseYellowNavyInverleith from "../assets/photos/staircase-yellow-navy-inverleith.jpg";
import hallwayTiledFloorShandon from "../assets/photos/hallway-tiled-floor-shandon.jpg";
import kitchenMustardYellowStockbridge from "../assets/photos/kitchen-mustard-yellow-stockbridge.jpg";
import kitchenFloralWallpaperStockbridge from "../assets/photos/kitchen-floral-wallpaper-stockbridge.jpg";
import wardrobeBuiltInStockbridge from "../assets/photos/wardrobe-built-in-stockbridge.jpg";
import bayWindowRoomInverleith from "../assets/photos/bay-window-room-inverleith.jpg";

const photos = [
  { src: staircaseYellowNavyInverleith, alt: "Repainted staircase with yellow panelling and navy treads, Inverleith, Edinburgh" },
  { src: bathroomGreenTile, alt: "Green tiled bathroom repaint with brass fixtures, Edinburgh" },
  { src: kitchenMustardYellowStockbridge, alt: "Mustard yellow kitchen repaint with window seat, Stockbridge, Edinburgh" },
  { src: wallpaperMural, alt: "Botanical mural wallpaper feature wall, Edinburgh interior" },
  { src: livingRoomSageGreen, alt: "Sage green living room repaint with fireplace, Edinburgh" },
  { src: exteriorNavyDoor, alt: "Freshly painted navy front door on a Georgian townhouse, Great King Street, New Town" },
  { src: bedroomWallpaperChandelier, alt: "Bedroom feature wallpaper hanging with chandelier, Edinburgh" },
  { src: hallwayTiledFloorShandon, alt: "Repainted hallway with patterned Victorian tile floor, Shandon, Edinburgh" },
  { src: kitchenFloralWallpaperStockbridge, alt: "Kitchen with floral feature wallpaper and oak island, Stockbridge, Edinburgh" },
  { src: wardrobeBuiltInStockbridge, alt: "Hand-painted, built-in wardrobe and shelving, Stockbridge, Edinburgh" },
  { src: bedroomDarkWoodwork, alt: "Bedroom with freshly painted dark woodwork and shutters, Edinburgh" },
  { src: bayWindowBareFloor, alt: "Repainted bay window room with dark wood flooring, Edinburgh" },
  { src: landingRadiator, alt: "Repainted landing with staircase bannister, Edinburgh" },
  { src: bayWindowCorner, alt: "Freshly painted room with bay window and garden doors, Edinburgh" },
  { src: landingPlain, alt: "Repainted landing with painted woodwork, Edinburgh" },
  { src: roomPlainDoor, alt: "Repainted room with painted doors and radiator, Edinburgh" },
  { src: scaffoldPrep, alt: "Interior preparation work ahead of redecoration, Edinburgh" },
  { src: wardrobeBurgundy, alt: "Hand-painted, fitted wardrobe in burgundy with brass handles, Edinburgh" },
  { src: wardrobeNavyEaves, alt: "Hand-painted, fitted eaves wardrobe in navy blue, Edinburgh" },
  { src: stainedGlassStaircase, alt: "Repainted staircase with original stained glass window, The Grange, Edinburgh" },
  { src: kitchenGreyIsland, alt: "Kitchen repaint with grey island and built-in shelving, Edinburgh" },
  { src: conservatoryExterior, alt: "Repainted Victorian conservatory exterior, East Lothian" },
  { src: bedroomTanPanelledDoor, alt: "Repainted room with panelled door and sash window, Edinburgh" },
  { src: communalStairMustard, alt: "Repainted communal tenement stairwell with mustard and terracotta colour scheme, Edinburgh" },
  { src: communalStairEntranceHall, alt: "Repainted communal tenement entrance hall and stairwell, Edinburgh" },
  { src: communalStairCorridor, alt: "Repainted communal tenement corridor with navy door, Edinburgh" },
  { src: paintSprayerEquipment, alt: "Paint spraying equipment set up ahead of a job, Edinburgh" },
  { src: amesTapingNewington, alt: "Ames taping and ceiling preparation in progress, Newington, Edinburgh" },
  { src: bedroomDarkGreenNewTown, alt: "Dark green bedroom repaint with period fireplace, New Town, Edinburgh" },
  { src: staircaseModernGrange, alt: "Repainted staircase with modern handrail, The Grange, Edinburgh" },
  { src: hallwayBirdWallpaperStockbridge, alt: "Hallway with feature bird and botanical wallpaper, Stockbridge, Edinburgh" },
  { src: bayWindowRoomInverleith, alt: "Repainted period room with bay window and light wood flooring, Inverleith, Edinburgh" },
];
---

<Layout
  title="Gallery | Bruce Clark Decoration"
  description="Photos of recent painting and decorating projects across Edinburgh by Bruce Clark Decoration."
  path="/gallery"
>
  <Breadcrumbs crumbs={[{ label: "Gallery", path: "/gallery" }]} />
  <PageHero title="Our Work" description="A selection of recent painting and decorating projects across Edinburgh." />

  <section class="mx-auto max-w-7xl px-4 py-14 sm:py-20 sm:px-6 lg:px-8">
    <div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
      {photos.map((p) => (
        <div class="mb-5 break-inside-avoid overflow-hidden rounded-2xl shadow-brand ring-1 ring-black/5">
          <Image src={p.src} alt={p.alt} width={900} height={900} class="w-full object-cover" />
        </div>
      ))}
    </div>
  </section>

  <CtaBand title="Like what you see?" description="Get in touch for a free, no-obligation quote on your own project." />
</Layout>
