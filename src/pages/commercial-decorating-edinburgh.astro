---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceSchema from "../components/ServiceSchema.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import Faq from "../components/Faq.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/business";

const service = services.find((s) => s.slug === "commercial-decorating-edinburgh")!;
---

<Layout
  title="Commercial Decorator Edinburgh | Bruce Clark Decoration"
  description={service.metaDescription}
  path={`/${service.slug}`}
>
  <ServiceSchema serviceName={service.name} description={service.metaDescription} path={`/${service.slug}`} />
  <Breadcrumbs crumbs={[{ label: service.shortName, path: `/${service.slug}` }]} />
  <PageHero title={service.name} description={service.summary} />

  <ServiceDetail photoCaption="Commercial decorating, Edinburgh premises" heading="Minimal disruption, maximum quality" bullets={service.bullets}>
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      We know a business can't always stop for decorating work. We schedule around your trading hours where needed, use durable paint systems suited to high-traffic areas, and leave the space clean and ready to use.
    </p>
  </ServiceDetail>

  <Faq faqs={service.faqs} title="Commercial Decorating: Common Questions" />
  <ServicesGrid currentSlug={service.slug} />
  <CtaBand title="Need a commercial decorator?" description="Get in touch for a free, no-obligation quote — including out-of-hours scheduling." />
</Layout>
