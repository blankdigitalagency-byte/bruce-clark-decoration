---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import CtaBand from "../components/CtaBand.astro";
import { business } from "../data/business";
---

<Layout
  title="About Bruce Clark Decoration | Edinburgh Painter & Decorator"
  description="Meet Bruce Clark Decoration — an Edinburgh painter and decorator with 26+ years' experience and a 5.0 rating from 28 Google reviews."
  path="/about-us"
>
  <Breadcrumbs crumbs={[{ label: "About Us", path: "/about-us" }]} />
  <PageHero title="About Bruce Clark Decoration" description="An Edinburgh decorator built on getting the job done properly, on time, and without fuss." />

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <PhotoPlaceholder caption="Bruce at work on site" aspect="wide" />
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Our Story</p>
        <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink-900">{business.yearsExperience} years of Edinburgh decorating</h2>
        <p class="mt-5 leading-relaxed text-ink-700/80">
          I've been painting and decorating in and around Edinburgh for over 26 years now, and in that time I've worked on everything from a single-room refresh to full interior and exterior projects across the city — tenement flats in Stockbridge, Georgian properties in the New Town, family homes in Morningside and Merchiston, and commercial units in between.
        </p>
        <p class="mt-4 leading-relaxed text-ink-700/80">
          It's a trade I still enjoy, which probably shows in the finish. I keep things straightforward: turn up when I say I will, give you an honest price, protect your home or premises properly, and leave the job tidy. That approach is, I think, the reason so many clients call me back for the next job or pass my name on to someone else.
        </p>
        <p class="mt-4 leading-relaxed text-ink-700/80">
          That word-of-mouth reputation is reflected in a {business.rating} rating from {business.reviewCount} reviews on Google — something I'm genuinely proud of after 26+ years in the trade.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-olive-50/50">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-ink-900">Why Choose Bruce Clark Decoration</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-black/5">
          <h3 class="font-display text-lg font-bold text-ink-900">26+ Years' Experience</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">A long track record across Edinburgh's period properties, modern builds and commercial premises.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-black/5">
          <h3 class="font-display text-lg font-bold text-ink-900">{business.rating} Rating, {business.reviewCount} Reviews</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">A consistent five-star reputation built through word of mouth and repeat clients.</p>
        </div>
        <div class="rounded-2xl bg-white p-7 shadow-sm ring-1 ring-black/5">
          <h3 class="font-display text-lg font-bold text-ink-900">Honest, Individual Pricing</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-700/75">No price lists or estimates pulled from thin air — every job is quoted on its own merits.</p>
        </div>
      </div>

      {business.certifications.length > 0 && (
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          {business.certifications.map((c) => (
            <span class="rounded-full border border-olive-600/25 bg-white px-4 py-2 text-xs font-semibold text-olive-700">{c.name}</span>
          ))}
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</Layout>
