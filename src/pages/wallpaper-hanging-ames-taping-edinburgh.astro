---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceSchema from "../components/ServiceSchema.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import Faq from "../components/Faq.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/business";
import wallpaperPhoto from "../assets/photos/wallpaper-mural-feature-wall.jpg";
import prepPhoto from "../assets/photos/ames-taping-newington.jpg";

const service = services.find((s) => s.slug === "wallpaper-hanging-ames-taping-edinburgh")!;
---

<Layout
  title="Wallpaper Hanging & Ames Taping Edinburgh | Bruce Clark Decoration"
  description={service.metaDescription}
  path={`/${service.slug}`}
>
  <ServiceSchema serviceName={service.name} description={service.metaDescription} path={`/${service.slug}`} />
  <Breadcrumbs crumbs={[{ label: service.shortName, path: `/${service.slug}` }]} />
  <PageHero title={service.name} description={service.summary} />

  <ServiceDetail
    photoCaption="Wallpaper hanging, Edinburgh interior"
    heading="Precise, pattern-matched wallpaper hanging"
    bullets={service.bullets.slice(0, 3)}
    image={wallpaperPhoto}
    imageAlt="Botanical mural wallpaper feature wall above a herringbone floor, Edinburgh"
  >
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Careful lining, precise pattern matching and clean seams are what make the difference to a finished room. We handle everything from a single feature wall to a full room, including delicate and heavyweight wallcoverings.
    </p>
  </ServiceDetail>

  <ServiceDetail
    photoCaption="Ames taping in progress, Newington"
    heading="Ames taping for a seamless wall finish"
    bullets={service.bullets.slice(3)}
    reverse
    image={prepPhoto}
    imageAlt="Ames taping and ceiling preparation in progress on a commercial job, Newington, Edinburgh"
  >
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Ames taping refers to taping and jointing drywall seams ready for a smooth painted finish. We use both mechanical taping tools and traditional hand taping, choosing whichever suits the job best rather than defaulting to one method — it's a specialist skill we're regularly asked for by builders and homeowners alike.
    </p>
  </ServiceDetail>

  <Faq faqs={service.faqs} title="Wallpaper & Ames Taping: Common Questions" />
  <ServicesGrid currentSlug={service.slug} />
  <CtaBand title="Have a wallpaper or taping project in mind?" description="Get in touch for a free, no-obligation quote." />
</Layout>
