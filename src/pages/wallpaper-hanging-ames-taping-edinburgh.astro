---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceSchema from "../components/ServiceSchema.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import Faq from "../components/Faq.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/business";

const service = services.find((s) => s.slug === "wallpaper-hanging-ames-taping-edinburgh")!;
---

<Layout
  title="Wallpaper Hanging & Ames Taping Edinburgh | Bruce Clark Decoration"
  description={service.metaDescription}
  path={`/${service.slug}`}
>
  <ServiceSchema serviceName={service.name} description={service.metaDescription} path={`/${service.slug}`} />
  <Breadcrumbs crumbs={[{ label: service.shortName, path: `/${service.slug}` }]} />
  <PageHero title={service.name} description={service.summary} />

  <ServiceDetail photoCaption="Wallpaper hanging, Edinburgh interior" heading="Precise, pattern-matched wallpaper hanging" bullets={service.bullets.slice(0, 3)}>
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Wallpaper hanging rewards patience — proper lining, careful pattern matching and clean seams are what separate a professional finish from a DIY one. We handle everything from a single feature wall to a full room, including delicate and heavyweight wallcoverings.
    </p>
  </ServiceDetail>

  <ServiceDetail photoCaption="Ames taping, drywall finish" heading="Ames taping for a seamless wall finish" bullets={service.bullets.slice(3)} reverse>
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Ames taping uses mechanical taping tools to apply joint tape and compound in a single, consistent pass — giving new drywall a smoother, more even finish than hand-taping, particularly over large wall and ceiling areas. It's a specialist skill we're regularly asked for by builders and homeowners alike.
    </p>
  </ServiceDetail>

  <Faq faqs={service.faqs} title="Wallpaper &amp; Ames Taping: Common Questions" />
  <ServicesGrid currentSlug={service.slug} />
  <CtaBand title="Have a wallpaper or taping project in mind?" description="Get in touch for a free, no-obligation quote." />
</Layout>
