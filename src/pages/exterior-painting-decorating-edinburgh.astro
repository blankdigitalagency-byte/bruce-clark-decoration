---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceSchema from "../components/ServiceSchema.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import Faq from "../components/Faq.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/business";
import servicePhoto from "../assets/photos/exterior-navy-front-door.jpg";

const service = services.find((s) => s.slug === "exterior-painting-decorating-edinburgh")!;
---

<Layout
  title="Exterior Painting Edinburgh | House Painter | Bruce Clark Decoration"
  description={service.metaDescription}
  path={`/${service.slug}`}
>
  <ServiceSchema serviceName={service.name} description={service.metaDescription} path={`/${service.slug}`} />
  <Breadcrumbs crumbs={[{ label: service.shortName, path: `/${service.slug}` }]} />
  <PageHero title={service.name} description={service.summary} />

  <ServiceDetail
    photoCaption="Exterior repaint, Great King Street, New Town"
    heading="How We Approach Exterior Painting"
    bullets={service.bullets}
    image={servicePhoto}
    imageAlt="Freshly painted navy front door on a Georgian townhouse, Great King Street, New Town, Edinburgh"
  >
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Edinburgh's exteriors — render, harling, sandstone and traditional woodwork — need thorough preparation, and the right conditions to paint in. Most exterior paints need a minimum temperature to cure properly, so we work around the forecast rather than painting regardless of the weather. We wash down, repair and prime beforehand, using systems suited to the surface and its exposure.
    </p>
  </ServiceDetail>

  <Faq faqs={service.faqs} title="Exterior Painting: Common Questions" />
  <ServicesGrid currentSlug={service.slug} />
  <CtaBand title="Have an exterior project in mind?" description="Get in touch for a free, no-obligation quote on your exterior painting project." />
</Layout>
