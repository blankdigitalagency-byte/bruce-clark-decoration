---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LocationSchema from "../components/LocationSchema.astro";
import PhotoPlaceholder from "../components/PhotoPlaceholder.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { locations } from "../data/business";

const location = locations.find((l) => l.slug === "stockbridge")!;
const path = `/decorator-in-${location.slug}-edinburgh`;
---

<Layout title={`Decorator in Stockbridge, Edinburgh | Bruce Clark Decoration`} description={location.metaDescription} path={path}>
  <LocationSchema areaName={location.name} path={path} />
  <Breadcrumbs crumbs={[{ label: `Decorator in ${location.name}`, path }]} />
  <PageHero title={`Decorator in ${location.name}, Edinburgh`} description={location.intro} />

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <PhotoPlaceholder caption={`Project in ${location.name}, Edinburgh`} aspect="wide" />
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Local Knowledge</p>
        <h2 class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink-900 sm:text-3xl">Decorating work around {location.name}</h2>
        <p class="mt-4 leading-relaxed text-ink-700/80">{location.propertyNote}</p>
        <p class="mt-4 text-sm font-medium text-ink-900">We regularly work near:</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {location.landmarks.map((l) => (
            <li class="rounded-full bg-olive-50 px-3.5 py-1.5 text-xs font-medium text-olive-700">{l}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <ServicesGrid />
  <Faq faqs={location.faqs} title={`${location.name} Decorator: Common Questions`} />
  <CtaBand title={`Need a decorator in ${location.name}?`} description="Get in touch today for a free, no-obligation quote." />
</Layout>
