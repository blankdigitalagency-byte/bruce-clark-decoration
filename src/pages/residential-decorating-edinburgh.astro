---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServiceSchema from "../components/ServiceSchema.astro";
import ServiceDetail from "../components/ServiceDetail.astro";
import Faq from "../components/Faq.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import { services } from "../data/business";
import servicePhoto from "../assets/photos/bedroom-wallpaper-chandelier.jpg";

const service = services.find((s) => s.slug === "residential-decorating-edinburgh")!;
---

<Layout
  title="Residential Decorator Edinburgh | Interior Painting | Bruce Clark Decoration"
  description={service.metaDescription}
  path={`/${service.slug}`}
>
  <ServiceSchema serviceName={service.name} description={service.metaDescription} path={`/${service.slug}`} />
  <Breadcrumbs crumbs={[{ label: service.shortName, path: `/${service.slug}` }]} />
  <PageHero title={service.name} description={service.summary} />

  <ServiceDetail
    photoCaption="Interior repaint, Edinburgh home"
    heading="How We Approach Interior Decorating"
    bullets={service.bullets}
    image={servicePhoto}
    imageAlt="Redecorated bedroom with feature wallpaper and chandelier, Edinburgh period property"
  >
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      We ask customers to remove small and personal items, and we take care of the rest. Furniture, floors and surrounding areas are protected with polythene and dust sheets throughout. Depending on what's required, preparation can include filling and repairs, sanding, sealing and priming before the finishing coats go on. We hoover as the work progresses, and leave everything clean and tidy when the job is finished.
    </p>
    <p class="mt-4 text-ink-700/80 leading-relaxed">
      Need wallpaper hung as part of the job? See our <a href="/wallpaper-hanging-ames-taping-edinburgh" class="font-medium text-olive-700 underline underline-offset-2">Specialist Finishes</a> page for full detail on wallpaper hanging and Ames taping.
    </p>
  </ServiceDetail>

  <Faq faqs={service.faqs} title="Residential Decorating: Common Questions" />
  <ServicesGrid currentSlug={service.slug} />
  <CtaBand title="Ready to refresh your home?" description="Get in touch for a free, no-obligation quote — we'll come and assess the job at a time that suits you." />
</Layout>
