---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import ValuesSection from "../components/ValuesSection.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import RecentWork from "../components/RecentWork.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { business } from "../data/business";

const homeFaqs = [
  {
    q: "What areas do you cover?",
    a: "We cover the whole of Edinburgh and the surrounding areas, and we're happy to travel further for the right job. Get in touch to confirm coverage for your postcode.",
  },
  {
    q: "Do you provide free quotes?",
    a: `Yes, every job is quoted individually and free of charge. Contact us on ${business.phoneDisplay} or use our online form and we'll arrange a time to see the job in person before confirming a price.`,
  },
  {
    q: "Do you do both interior and exterior work?",
    a: "Yes, we handle interior painting, wallpaper hanging and Ames taping as well as exterior painting and decorating on render, sandstone and woodwork.",
  },
  {
    q: "Can you take on commercial and rental property work?",
    a: "Yes, we regularly decorate offices, shops, stairwells and let properties, and can schedule around trading hours or tenancy turnaround.",
  },
  {
    q: "How far in advance should I book?",
    a: "It depends on the season and job size — get in touch as early as you can and we'll give you an honest idea of our current availability.",
  },
];
---

<Layout
  title="Painter & Decorator Edinburgh | Bruce Clark Decoration"
  description="Bruce Clark Decoration provides residential and commercial painting and decorating across Edinburgh and the Lothians, with 26+ years' experience and a 5-star Google rating."
  path="/"
>
  <Hero answerSentence={`${business.name} provides tailored residential and commercial painting and decorating across Edinburgh and the Lothians — proper preparation, careful attention to detail and a professional finish on every job, backed by over ${business.yearsExperience.replace("+", "")} years' experience.`} />

  <TrustBar />
  <ServicesGrid />
  <ValuesSection />
  <ProcessSteps />
  <RecentWork />

  <section class="bg-olive-50/50">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-olive-600">Coverage</p>
      <h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-ink-900 sm:text-4xl">
        All of Edinburgh <span class="text-olive-600">&amp; the Lothians</span>
      </h2>
      <p class="mt-4 text-lg text-ink-700/80">
        We're not limited to a handful of postcodes — we cover the whole of Edinburgh and the surrounding areas, from tenement flats to detached villas, and we'll happily travel further for the right job.
      </p>
    </div>
  </section>

  <Faq faqs={homeFaqs} subtitle="Straight answers to the questions Edinburgh homeowners and businesses ask us most." />
  <Testimonials background="olive" />
  <CtaBand />
</Layout>
